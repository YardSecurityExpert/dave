{
  "manifest_version": 3,
  "name": "Dave for ChatGPT",
  "version": "0.3.0",
  "description": "Connect a ChatGPT conversation to Dave on your Mac.",
  "key": "",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "nativeMessaging"
  ],
  "incognito": "not_allowed",
  "background": {
    "service_worker": "worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Connect this chat to Dave",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.png",
      "32": "icon.png"
    }
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none';"
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icon.png",
    "32": "icon.png",
    "48": "icon.png",
    "128": "icon.png"
  }
}
